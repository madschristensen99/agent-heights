# Agent HQ environment variables

# Server port (Railway sets this automatically; 3001 for local dev)
PORT=3001

# Supabase (shared with the Swarms Marketplace)
# Server-side:
SUPABASE_URL=https://epvxmjqxtlqhxrpcrldq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client-side (Vite requires VITE_ prefix):
VITE_SUPABASE_URL=https://epvxmjqxtlqhxrpcrldq.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI provider keys
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Marketplace URL (for Yuki proxy — points to the marketplace app)
MARKETPLACE_URL=http://localhost:3000

# If Supabase vars are not set, the server runs in dev mode (no auth, file-based persistence)
