# Agent HQ environment variables

# ── Required ──────────────────────────────────────────────────────────────

# Swarms API key — powers all agent LLM calls via the Cline SDK
# Get one at https://swarms.world/platform/api-keys
SWARMS_API_KEY=your-swarms-api-key

# ── Optional: Supabase (enables auth + per-user persistence) ──────────────
# If not set, the server runs in dev mode (no auth, single shared user,
# file-based persistence in ag/)
# Server-side:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Client-side (Vite requires VITE_ prefix):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Optional: Marketplace ─────────────────────────────────────────────────
# URL of the Swarms Marketplace app (used by Yuki chat proxy)
MARKETPLACE_URL=http://localhost:3000

# ── Optional: Client WebSocket host ───────────────────────────────────────
# Only needed if the WebSocket is on a different host/port than the page
# (e.g. separate backend deployment). Defaults to location.host.
# VITE_WS_HOST=ws://localhost:3001

# ── Optional: Server port ─────────────────────────────────────────────────
# Railway sets this automatically. For local dev, defaults to 3001.
# PORT=3001
